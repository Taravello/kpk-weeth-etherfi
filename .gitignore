# This project uses no secrets at all. These entries stay as a standing guard so
# a key can never be committed here by accident (e.g. a configurator copied in
# from a sibling kpk repo).
configurator.json
.env
*.key

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Local noise
logs/
.DS_Store
Thumbs.db
